# HTTPS in front of the app.
#
# Two postures, one file, selected by environment. A reverse proxy rather than
# TLS in the Node process: certificate renewal, HTTP/2 and a redirect from
# plain HTTP are all solved problems, and none of them belong in a quoting
# application.
#
# CADDY_SITE decides which:
#
#   https://quotes.example.com   a real domain, so Caddy obtains a public
#                                certificate automatically. Needs ports 80 and
#                                443 reachable and DNS pointing here.
#
#   https://192.168.1.50         a LAN address, so Caddy issues one from its
#                                own internal CA. Browsers will warn until that
#                                CA is trusted on each device -- see
#                                README-access.md. This is the trade for
#                                HTTPS with no domain and no internet.
#
# Behind Cloudflare Tunnel this container is not used at all: Cloudflare
# terminates TLS at its edge and cloudflared reaches the app over the compose
# network, so nothing is published and there is no certificate to manage.

{
	# An operator email means Let's Encrypt can warn about expiry. Empty is
	# fine for the internal CA, which never expires against a public authority.
	email {$CADDY_EMAIL:}
	# The internal CA's own lifetime. Long, because re-trusting a new root on
	# every device in an office is the kind of chore that ends with somebody
	# clicking through the warning forever.
	pki {
		ca local {
			name "Scopeline local authority"
		}
	}
}

{$CADDY_SITE:localhost} {
	# The app publishes no port of its own in this configuration; Caddy reaches
	# it over the compose network. That is what makes the proxy the only way in
	# rather than one of two ways in.
	reverse_proxy app:3000 {
		# Streamed rather than buffered: a PDF is generated on demand and can
		# take a few seconds, and buffering it delays the first byte for no gain.
		flush_interval -1
	}

	encode zstd gzip

	header {
		# HSTS is deliberately NOT set for the LAN posture -- pinning a browser
		# to HTTPS for a bare IP address is a change somebody cannot undo
		# without clearing state on every device. Set CADDY_HSTS=max-age=31536000
		# only for a real domain.
		Strict-Transport-Security "{$CADDY_HSTS:}"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The app serves no third-party script and no external stylesheet. Fonts
		# are self-hosted from node_modules for exactly this reason.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	log {
		output stdout
		format console
	}
}
