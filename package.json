{
  "name": "jobbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && npm run db:migrate:test",
    "db:migrate:dev": "drizzle-kit migrate",
    "db:migrate:test": "node scripts/migrate-test-db.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:seed": "tsx --env-file=.env scripts/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.7.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.11",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "playwright": "^1.62.1",
    "postgres": "3.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "description": "Quoting, documents and job costing for a general contractor."
}
