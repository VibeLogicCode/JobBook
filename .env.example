DATABASE_URL=postgres://quote:quote_dev_only@127.0.0.1:5433/quote
TEST_DATABASE_URL=postgres://quote:quote_dev_only@127.0.0.1:5433/quote_test

APP_PORT=3000
INTERNAL_BASE_URL=http://127.0.0.1:3000
INTERNAL_RENDER_SECRET=change-me-to-a-long-random-string
AUTH_MODE=local
# Must match a users row, or every screen renders read-only and says so:
# authorization is a lookup against users, and local mode is not exempt from it.
# The demo seed creates owner@northgate.example.
LOCAL_USER_EMAIL=owner@northgate.example
SEED_DEMO=1

# Where uploaded files are stored. The container mounts a volume at /data/files;
# locally this defaults to .data/files under the repo.
FILES_ROOT=

# Backup. Generate the keypair on a workstation, never on the server:
#   age-keygen -o backup-key.txt
# Only the PUBLIC half (age1...) goes here, so the machine writes backups it
# cannot read. Keep the private half in a password manager, off this box.
# Unset means no backups are taken and the boot says so.
BACKUP_AGE_PUBLIC_KEY=
# Host path of the USB drive, bind-mounted at the same path in compose.
BACKUP_USB_DIR=
# A URL pinged only on success, so a backup that never runs is noticed.
BACKUP_HEARTBEAT_URL=

# How often the sidecar dumps. 60 by default.
BACKUP_INTERVAL_MINUTES=60

# --- Reaching the app: see docker/README-access.md ---
# Bound to loopback by default. 0.0.0.0 exposes plain HTTP to the network.
APP_BIND=127.0.0.1
# HTTPS profile: a real domain gets a public certificate, a LAN address gets
# one from Caddy internal CA that each device must be told to trust.
CADDY_SITE=
CADDY_EMAIL=
CADDY_HSTS=
# Tunnel profile: the token from the Cloudflare dashboard. A credential.
TUNNEL_TOKEN=
# Where the setup wizard writes its configuration inside the container.
DEPLOY_CONFIG_PATH=/data/config/auth.env
