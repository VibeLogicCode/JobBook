# NOTE ON GENERATING THESE: use `openssl rand -hex`, not `-base64`.
#
# POSTGRES_PASSWORD is interpolated into a connection URL
# (postgres://quote:PASSWORD@db:5432/quote), and base64 emits `/`, `+` and `=`.
# A `/` in the password position ends the URL early -- the app then cannot
# reach the database, and because the healthcheck QUERIES the database, the
# container reports unhealthy rather than failing with anything that names the
# cause. Hex has no such characters.

# ---------------------------------------------------------------------------
# WHERE THE DATA LIVES -- check this before anything else
# ---------------------------------------------------------------------------
#
# A Synology's first storage volume is /volume1, but it is not always the one
# Container Manager was installed on: a NAS whose packages went onto a second
# pool keeps them under /volume2, and a bind mount pointing at a volume the
# package does not live on is the kind of mistake that surfaces as a database
# that will not start.
#
# Check DSM > Package Center > Container Manager, or Storage Manager, and set
# this to match. Everything else -- db, files, backups, config -- hangs off it.
SCOPELINE_DATA=/volume1/docker/scopeline

# Copy this file to .env, in this same folder, before `docker compose up`.
# Container Manager reads a .env beside the compose file automatically; this
# is that file, made explicit rather than assumed. Every variable
# docker-compose.yml references is listed here -- nothing is expected to
# arrive from anywhere else.

# --- Database ---------------------------------------------------------------

# The password for the `quote` Postgres role. Required -- the compose file
# refuses to start without it (POSTGRES_PASSWORD is also baked into
# DATABASE_URL for every service that talks to the database). Generate one:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# --- Required app secrets ----------------------------------------------------

# Authenticates requests the app's own PDF renderer makes to itself, over
# loopback, inside the container. Required. Generate one:
#   openssl rand -hex 48
INTERNAL_RENDER_SECRET=

# --- LAN posture (see the AUTH_MODE comment in docker-compose.yml) ----------

# 'local' authenticates nobody -- every visitor is treated as the one address
# below. Correct only on a network you control. Leave as 'local' for this
# deployment; anything else needs the Cloudflare Tunnel + Access or in-app SSO
# setup described in docker/README-access.md in the source repo, which this
# file does not wire up.
AUTH_MODE=local

# OPTIONAL. Leave it blank and the app works out who you are.
#
# Blank: with no accounts, nobody is signed in and the setup wizard still runs
# -- so a fresh install can create its first account with nothing configured.
# From then on, the single account IS the signed-in user. Add a second account
# and the app stops guessing and says so; that is when you set this.
#
# Set it, and it always wins -- it must then match an ACTIVE row in `users`,
# or every screen renders read-only and says why.
#
# One case where you do want it set: SEED_DEMO=1. The demo tenant's accounts
# are created by the seed, and it makes more than one, so leaving this blank
# with the demo loaded is the "refuses to guess" case. Use the demo owner's
# address (see docker-compose.app.yml in the source repo).
LOCAL_USER_EMAIL=

# Loads the fictional demo tenant on first boot. MUST be 0 before a real
# company's records go in -- see README.md, "Before real data goes in". Leave
# at 1 only long enough to confirm the deployment works, then set to 0 and
# wipe the database directory before starting again on real data.
SEED_DEMO=1

# --- Reaching the app on the LAN ---------------------------------------------

# 0.0.0.0 so the app is reachable from a phone or another machine on the LAN
# -- the point of running this on a NAS rather than a laptop. Set to
# 127.0.0.1 if this NAS is only ever reached from itself or through something
# else terminating TLS in front of it.
APP_BIND=0.0.0.0

# DSM itself occupies 5000 and 5001, and often 80 and 443 through its own
# reverse proxy. This default is a high port unlikely to collide with any of
# those or with another package's container. Change it if it does.
APP_PORT=38080

# --- Backup (see README.md, "Backups" -- read it before real data goes in) -

# A PUBLIC age recipient key (age1...), generated on a workstation, NEVER on
# this NAS:
#   age-keygen -o backup-key.txt
# Only the public half goes here. Unset means this deployment takes NO
# backups at all, and the boot says so on every start.
BACKUP_AGE_PUBLIC_KEY=

# Host path of a USB drive attached to the NAS, bind-mounted at the same path
# in docker-compose.yml (uncomment the volume lines there too). Leave unset to
# skip this tier -- the internal copy still runs, on the same disk as the
# database, which backup.sh will say out loud on every run.
BACKUP_USB_DIR=

# A URL pinged only when a backup succeeds -- healthchecks.io or equivalent --
# so a NAS that is off, unplugged, or has lost network is noticed by the
# monitor's silence rather than never.
BACKUP_HEARTBEAT_URL=

# How often the backup sidecar dumps, in minutes. 60 by default; the dump is
# a few megabytes and stays that way for years, so there is little reason to
# lower this.
BACKUP_INTERVAL_MINUTES=60

# Retention for the internal and USB copies. 48 hours of hourly dumps, plus
# the last dump of each day for 30 days.
BACKUP_RETAIN_HOURLY_HOURS=48
BACKUP_RETAIN_DAILY_DAYS=30

# --- Reminders ---------------------------------------------------------------

# How often the reminder sidecar evaluates due-date rules, in minutes. There
# is no cost to running it more often than the default -- an evaluation that
# finds nothing new inserts nothing.
REMINDER_INTERVAL_MINUTES=60

# --- Not used by this file, left out on purpose ------------------------------
#
# CF_ACCESS_TEAM_DOMAIN, CF_ACCESS_AUD, TUNNEL_TOKEN, APP_PUBLIC_URL,
# SSO_COOKIE_SECRET, GOOGLE_CLIENT_ID/SECRET, MICROSOFT_CLIENT_ID/SECRET/
# TENANT_ID, APPLE_CLIENT_ID, CADDY_SITE/EMAIL/HSTS -- all belong to the
# Tunnel+Access, in-app SSO, or HTTPS postures docker/README-access.md
# describes in the source repo. This compose file only wires up the LAN
# posture (AUTH_MODE=local); adding one of the others means extending
# docker-compose.yml with the matching service from docker-compose.app.yml
# first.
